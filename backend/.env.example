# Copie para .env e ajuste se necessário: cp .env.example .env
# Os valores abaixo funcionam com o Postgres do docker-compose.yml da raiz.

NODE_ENV=development
PORT=3000

# Postgres do docker compose (porta 5433 no host, para não conflitar com outro Postgres local)
DATABASE_URL=postgresql://mini_erp:mini_erp@localhost:5433/mini_erp

# Banco usado pelos testes e2e (criado automaticamente pelo docker compose)
TEST_DATABASE_URL=postgresql://mini_erp:mini_erp@localhost:5433/mini_erp_test

# Origens liberadas no CORS, separadas por vírgula. Nunca use "*".
CORS_ORIGINS=http://localhost:5173

# Fuso usado para fechar os períodos dos relatórios
REPORTS_TIMEZONE=America/Fortaleza

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Rate limit global: no máximo THROTTLE_LIMIT requisições a cada THROTTLE_TTL_MS por IP
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
