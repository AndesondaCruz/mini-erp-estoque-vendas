# Copie para .env e ajuste se necessário: cp .env.example .env
# Os valores abaixo funcionam com o Postgres do docker-compose.yml da raiz.

NODE_ENV=development
PORT=3000

# Postgres do docker compose (porta 5433 no host, para não conflitar com outro Postgres local)
DATABASE_URL=postgresql://mini_erp:mini_erp@localhost:5433/mini_erp

# Banco usado pelos testes e2e (criado automaticamente pelo docker compose)
TEST_DATABASE_URL=postgresql://mini_erp:mini_erp@localhost:5433/mini_erp_test

# Origens liberadas no CORS, separadas por vírgula. Nunca use "*".
CORS_ORIGINS=http://localhost:5173

# Fuso usado para fechar os períodos dos relatórios
REPORTS_TIMEZONE=America/Fortaleza

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Rate limit global: no máximo THROTTLE_LIMIT requisições a cada THROTTLE_TTL_MS por IP
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Rate limit das rotas sensíveis (login, troca de senha), contra força bruta
STRICT_THROTTLE_TTL_MS=60000
STRICT_THROTTLE_LIMIT=5

# Quantos proxies confiáveis existem na frente da API. 0 = nenhum (local).
# Atrás do Render, use 1; com a Vercel repassando para o Render, 2.
TRUST_PROXY=0

# Segredo do access token (mínimo 32 caracteres). Gere um com:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=troque-este-segredo-local-por-um-gerado-com-o-comando-acima
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Primeiro ADMIN, criado por "npm run seed" se ainda não existir nenhum ADMIN
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@mini-erp.local
SEED_ADMIN_PASSWORD=troque-esta-senha
