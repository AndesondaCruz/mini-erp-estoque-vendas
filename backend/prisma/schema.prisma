// Schema do Mini-ERP. Convenções:
// - chaves primárias UUID
// - datas em timestamptz (UTC); o fuso só é aplicado nos relatórios
// - nomes no banco em snake_case via @map/@@map; no código, camelCase
// A URL do banco fica em prisma.config.ts, lida da variável DATABASE_URL.

// As opções de módulo são explícitas para o código gerado ser idêntico em
// qualquer ambiente. Sem elas, o Prisma deduz a extensão dos imports lendo o
// tsconfig.json, e no Docker (onde o generate roda antes do tsconfig ser
// copiado) gerava imports ".ts", que o Node não consegue carregar.
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  GERENTE
  VENDEDOR
}

model User {
  id           String  @id @default(uuid()) @db.Uuid
  name         String  @db.VarChar(120)
  // Sempre em minúsculas (garantido por CHECK na migration), para o UNIQUE
  // não aceitar "Ana@x.com" e "ana@x.com" como e-mails diferentes.
  email        String  @unique @db.VarChar(254)
  passwordHash String  @map("password_hash")
  role         Role
  active       Boolean @default(true)
  // Incrementado ao trocar a senha ou desativar o usuário. Access tokens
  // emitidos com uma versão antiga deixam de valer na hora.
  tokenVersion Int     @default(0) @map("token_version")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  refreshTokens  RefreshToken[]
  auditLogs      AuditLog[]
  stockMovements StockMovement[]

  @@map("users")
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  // Todos os tokens de uma mesma sessão (login) compartilham o familyId.
  // Se um token já rotacionado reaparecer, a família inteira é revogada.
  familyId     String    @map("family_id") @db.Uuid
  // SHA-256 em hexadecimal. O token em si nunca é gravado.
  tokenHash    String    @unique @map("token_hash") @db.Char(64)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  // Preenchido na rotação: aponta para o token que substituiu este.
  replacedById String?   @unique @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  replacedBy RefreshToken? @relation("Rotation", fields: [replacedById], references: [id], onDelete: Restrict)
  replaces   RefreshToken? @relation("Rotation")

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// Somente inserção: a API não expõe edição nem exclusão de auditoria.
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  // Opcional: um login com e-mail inexistente não tem usuário.
  userId    String?  @map("user_id") @db.Uuid
  action    String   @db.VarChar(64)
  entity    String?  @db.VarChar(64)
  entityId  String?  @map("entity_id") @db.VarChar(64)
  before    Json?
  after     Json?
  metadata  Json?
  ip        String?  @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Catálogo
// ---------------------------------------------------------------------------

model Category {
  id   String @id @default(uuid()) @db.Uuid
  // citext: compara sem diferenciar maiúsculas. Guarda "Bebidas" como foi
  // digitado, mas o UNIQUE recusa "bebidas" como categoria nova.
  name String @unique @db.Citext

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  products Product[]

  @@map("categories")
}

model Supplier {
  id       String  @id @default(uuid()) @db.Uuid
  name     String  @db.VarChar(120)
  // CNPJ sem máscara, em maiúsculas: 12 posições alfanuméricas + 2 dígitos
  // verificadores (formato alfanumérico da Receita). Opcional; quando
  // presente, é único (o UNIQUE do Postgres aceita vários NULL).
  document String? @unique @db.Char(14)
  phone    String? @db.VarChar(20)
  email    String? @db.VarChar(254)
  active   Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  products Product[]

  @@index([name])
  @@map("suppliers")
}

model Product {
  id         String  @id @default(uuid()) @db.Uuid
  // Sempre em maiúsculas (CHECK na migration): "cer-350" e "CER-350" são o mesmo SKU.
  sku        String  @unique @db.VarChar(40)
  name       String  @db.VarChar(160)
  categoryId String  @map("category_id") @db.Uuid
  // Opcional: muita compra de pequeno comércio é feita no atacarejo, sem
  // fornecedor cadastrado.
  supplierId String? @map("supplier_id") @db.Uuid

  // Dinheiro em Decimal, nunca float.
  costPrice    Decimal @map("cost_price") @db.Decimal(12, 2)
  salePrice    Decimal @map("sale_price") @db.Decimal(12, 2)
  minStock     Int     @default(0) @map("min_stock")
  // Saldo desnormalizado. Só o StockService (Fase 3) altera este campo,
  // sempre junto com uma movimentação. A API de produtos não o aceita.
  currentStock Int     @default(0) @map("current_stock")
  active       Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  category  Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  supplier  Supplier?       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  movements StockMovement[]

  @@index([categoryId])
  @@index([supplierId])
  @@index([name])
  @@map("products")
}

// ---------------------------------------------------------------------------
// Estoque
// ---------------------------------------------------------------------------

enum StockMovementType {
  ENTRADA
  SAIDA
  AJUSTE
  ESTORNO
}

// Imutável: só INSERT. Um trigger no banco bloqueia UPDATE e DELETE.
// O saldo do produto é sempre a soma de quantity (risco 3 do plano).
model StockMovement {
  id           String            @id @default(uuid()) @db.Uuid
  productId    String            @map("product_id") @db.Uuid
  type         StockMovementType
  // Com sinal: positivo soma ao saldo, negativo subtrai.
  quantity     Int
  // Saldo do produto logo depois desta movimentação (extrato e conferência).
  balanceAfter Int               @map("balance_after")
  reason       String?           @db.VarChar(255)
  // Responsável pela movimentação.
  userId       String            @map("user_id") @db.Uuid
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([productId, createdAt])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("stock_movements")
}
